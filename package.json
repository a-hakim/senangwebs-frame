{
  "name": "senangwebs-frame",
  "version": "1.2.6",
  "description": "Lightweight, touch-friendly JavaScript slider library that provides a modern, responsive carousel experience with smooth transitions and intuitive navigation.",
  "main": "dist/swf.js",
  "style": "dist/swf.css",
  "unpkg": "dist/swf.min.js",
  "jsdelivr": "dist/swf.min.js",
